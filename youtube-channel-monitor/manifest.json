{
  "manifest_version": 3,
  "name": "YouTube Channel Monitor",
  "version": "1.1.2",
  "description": "Monitor YouTube channels for new videos",
  "permissions": ["bookmarks", "storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Channel Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "check-now": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Check for new videos now"
    }
  }
}